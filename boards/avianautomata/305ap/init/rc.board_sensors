#!/bin/sh
#
# 305AP board sensors init
#------------------------------------------------------------------------------

board_adc start

# SPI1 BMP581 baro
bmp581 -s start

# SPI2 ICM-45686 IMU1 (rotation TBD - set after board calibration)
icm45686 -b 2 -s -R 0 start

# SPI3 ICM-45686 IMU2 (rotation TBD - set after board calibration)
icm45686 -b 3 -s -R 0 start

# I2C1 MMC5983MA magnetometer
mmc5983ma -I start
